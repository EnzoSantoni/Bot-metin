# Entorno y cachés de Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Salidas del bot (logs y capturas de depuración)
logs/
debug/

# Datos del usuario (mapa de metin aprendido)
/data/

# Configuración personal: se crea a partir de config.example.jsonc (ver README)
config.json

# Ajustes locales de Claude Code
.claude/settings.local.json

# Capturas del juego (~35 MB; muestran el nombre del personaje y el chat de otros jugadores).
# Fuera del repo hasta que Enzo decida. Para subirlas: borrar esta línea, `git add samples` y commit.
samples/

# Copias de seguridad de calibrate.py (config.json.bak, perfiles .bak)
*.bak

# Ultimas opciones de la interfaz (gui.py)
ui_settings.json

# Mapa de metin por zona (aprendido jugando)
profiles/zonas/*.mapa.json

.claude/worktrees/
