{
  // Texto (o parte unica del texto) del titulo de la ventana del juego.
  // Corre `.venv\Scripts\python.exe list_windows.py` para ver los titulos y copia el tuyo.
  "window_title": "Guabina",

  // Tamano esperado del area de cliente (sin barra de titulo). Si la ventana mide otra cosa
  // solo se avisa en el log; cambialo solo si jugas a otra resolucion.
  "expected_client_size": [1858, 1057],

  // Espera tras traer el juego al frente. mss captura lo que se VE en pantalla: Windows tarda
  // en redibujar (y en animar el restaurar si estaba minimizado), y una captura temprana
  // todavia muestra la ventana anterior encima.
  "window": {
    // ms que el juego tiene que estar al frente y sin tapar antes de capturar / mandar input.
    "settle_ms": 500,
    // ms entre chequeos de "el juego no esta tapado por otra ventana".
    "unobstructed_poll_ms": 50
  },

  "log": {
    // Nivel de logging: DEBUG, INFO, WARNING, ERROR. Usa DEBUG solo para diagnosticar.
    "level": "INFO",
    // Carpeta donde se guarda el archivo de log (relativa al proyecto).
    "dir": "logs",
    // Nombre del archivo de log (rota a 5 MB, 3 copias).
    "file": "bot.log"
  },

  // Mapa de metin: al romper un metin se guarda la posicion del personaje (pegado a la piedra) con la hora. Cuando no
  //  se ve ningun metin cerca (BUSCAR mira una captura), el bot va al punto conocido mas cercano que ya deberia tener metin
  //  y no visito hace poco, mirando mientras camina (si ve un metin, lo ataca) y look_frames capturas al llegar; si no hay,
  //  sigue con el proximo punto. La vuelta de busqueda completa queda solo para cuando no hay ningun punto listo.
  //  Reaparicion: al romper otra vez un metin en un punto roto en ESTA sesion se mide cuanto tardo (cota: desde la rotura
  //  anterior hasta el clic al nuevo); el punto guarda la menor y los puntos sin medir usan la mediana de los medidos (o
  //  respawn_s). Las horas de sesiones viejas no cuentan. Persiste entre sesiones (archivo JSON; borralo para empezar de
  //  cero). Con --observar no escribe.
  //  enabled: usar el mapa. file: ruta (relativa al proyecto; la carpeta data/ esta en .gitignore).
  //  merge_u: un metin roto a esta distancia (unidades) o menos de un punto conocido es el mismo punto.
  //  respawn_s: reaparicion supuesta mientras no se midio ninguna (ESTIMADO: "a los pocos minutos").
  //  revisit_s: no volver a un punto visitado hace menos de esto. arrive_u: llegada al punto (unidades).
  //  max_walk_s: tope de caminata hacia un punto; al agotarlo se lo da por visitado.
  //  map_name: nombre del mapa (se guarda en el archivo y sale en los logs; si no coincide avisa). file: por defecto
  //  "data/<nombre>.mapa.json"; si existe el viejo data/mapa_metin.json y el nuevo no, se migra solo (el viejo queda .migrado).
  "spawns": {"enabled": true, "map_name": "Ciudad 1", "file": "data/Ciudad 1.mapa.json", "merge_u": 6.0, "respawn_s": 240, "revisit_s": 120,
             "arrive_u": 5.0, "max_walk_s": 40, "look_frames": 2},

  "debug": {
    // true guarda capturas anotadas con lo detectado. Activalo solo para depurar: ocupa disco.
    "enabled": false,
    // Carpeta de salida de las capturas de debug (y de capture_preview.png). Con enabled, cada corrida guarda un JPEG
    // anotado por evento en <dir>/run_<fecha_hora>/NNNN_<estado>_<motivo>.jpg, mas un events.log (una linea por imagen).
    // Eventos: cambio de estado, metin o piedra descartados/ignorados, intento de destrabe, entrada a ACERCARSE y, mientras
    // explora, una imagen cada explore_every_s. max_images: tope por corrida. jpeg_quality: 1-100.
    // max_per_kind: tope de imagenes por tipo de evento (estado = cambios de estado, descarte, destrabe, ignorada,
    // equivocada = seleccion equivocada, bloqueado, explorar = la periodica); lo que pase del tope no se guarda.
    // reason_memory_s: un motivo de "no elegido" que desaparece y vuelve antes de este tiempo (parpadeo de la deteccion)
    // no cuenta como nuevo: no genera otra linea de log ni otra imagen.
    "dir": "debug",
    "explore_every_s": 30.0,
    "max_images": 400,
    "jpeg_quality": 80,
    "max_per_kind": {"estado": 150, "descarte": 40, "destrabe": 60, "ignorada": 20, "equivocada": 20,
                     "bloqueado": 20, "explorar": 40},
    "reason_memory_s": 60.0,
    // Lecturas de coordenadas fallidas o descartadas: recorte x4 de la zona en <run>/coordenadas/NNNN_<motivo>.png
    // (motivo: sin_lectura, confianza, salto). max_coord_crops: tope por corrida; coord_crop_every_s: separacion minima.
    "max_coord_crops": 60,
    // Capturas sueltas sin dibujos con la hora en el nombre (<run>/recoger/: antes de subirse al caballo y objetos
    // salteados). max_snapshots: tope por corrida.
    "max_snapshots": 400,
    "coord_crop_every_s": 1.0,
    // save_raw: junto a cada imagen anotada guarda la captura CRUDA (sin dibujos) como NNNN_..._raw.png (cuenta para
    // max_images): sirve de caso de prueba limpio.
    "save_raw": true
  },

  // Alarma sonora (captcha o muerte): winsound.Beep en un hilo hasta que se la para.
  "alarm": {
    "freq": 1000,        // Hz (37 a 32767)
    "beep_ms": 400,      // duracion de cada beep
    "pause_ms": 300,     // pausa entre beeps
    "max_seconds": 0     // corta sola a los N segundos; 0 = suena hasta stop()
  },

  // Teclas del juego. "ctrl+g" = combinacion (se aprietan en orden y se sueltan al reves).
  // Tienen que estar TODAS las acciones de abajo, con teclas conocidas (bot/input/base.py: VALID_KEYS),
  // y ninguna puede ser panic_key ni pause_key (el hook veria la tecla que manda el bot).
  "controls": {
    "attack_forward": "space", "pickup": "z", "mount": "ctrl+g", "buff": "f1",
    "camera_left": "q", "camera_right": "e",
    "camera_top": "g",           // sube el plano de la camara (vista desde arriba)
    "camera_flat": "t",          // baja el plano (perspectiva mas plana); mantenida llega a plano y ACERCA la camara
    "move_up": "w", "move_left": "a", "move_down": "s", "move_right": "d",
    //  deselect: SIN USO. El bot ya no aprieta Escape (con nada seleccionado abre el menu de opciones del juego); para dejar
    //  a un monstruo se hace clic directo en el metin. Queda por compatibilidad.
    //  close_menu: SOLO si el menu de opciones del juego esta abierto y el clic en su boton Cancelar no lo cerro tras
    //  vision.game_menu.close_clicks intentos (con el menu abierto, Escape si lo cierra).
    "deselect": "esc", "close_menu": "esc"
  },

  // Seguridad (bot/control.py). Si el juego corre como administrador, ejecuta el bot como administrador:
  // si no, Windows puede no entregar F11/F12 mientras el juego tiene el foco.
  "safety": {
    "panic_key": "f12",          // detiene el bot al instante y suelta todo
    "pause_key": "f11",          // alterna pausa / reanudar (distinta de panic_key)
    "corner_px": 5,              // mouse a <= N px de la esquina sup. izq. de la PANTALLA = panico
    "corner_poll_ms": 50,        // cada cuanto se mira el cursor
    "countdown_s": 5,            // cuenta regresiva antes de arrancar
    "hard_kill_after_s": 2.0     // > 0. Si tras el panico el loop no termina en N s, se suelta todo y se corta el proceso
  },

  // Input. Rangos [min, max] en ms (aleatorios por accion).
  "input": {
    "backend": "pydirectinput",
    "click_jitter_px": 4,        // variacion aleatoria de la posicion del clic (radio)
    "delay_ms": [60, 140],       // pausa entre acciones
    "key_hold_ms": [50, 110],    // tiempo que se mantiene una tecla
    "move_settle_ms": [30, 80]   // espera tras mover el mouse y antes del clic
  },

  // Nombres EXACTOS de los metin a atacar (lista no vacia; cualquiera de ellos es objetivo y se elige el mas
  // cercano). Cada uno se verifica contra una plantilla en templates/labels/<slug>.png,
  // slug = minusculas, sin tildes, espacios -> "_"; se genera con tools/make_label_template.py.
  // Los demas (ej. "Metin de Avaricia") se detectan pero se ignoran.
  // Compatibilidad: la clave vieja "target_metin_name" (texto) se convierte a lista con un WARNING.
  "target_metin_names": ["Metin de Oscuridad", "Metin Negro"],

  // Zona de farmeo poligonal, en coordenadas del juego (las que se leen debajo del minimapa).
  //  polygon: >= 3 vertices [x, y] en orden de contorno, sin cruces, area > 0.
  //  outside_tolerance: cuanto puede alejarse el personaje hacia afuera del borde (unidades del juego, >= 0).
  //    Adentro = INSIDE; afuera a <= tolerancia = TOLERANCE (se acepta); mas lejos = OUTSIDE. Ver bot/zone.py.
  "farm_zone": {
    "polygon": [[439, 141], [753, 91], [702, 203], [436, 196]],
    "outside_tolerance": 30
  },

  // Filtro de coordenadas leidas (bot/tracking.py). Un salto es imposible si dist > max_speed*dt + slack.
  //  max_speed: unidades del juego por segundo (> 0, con margen sobre la velocidad real del caballo).
  //  slack: tolerancia fija en unidades (ruido de lectura). accept_after: lecturas rechazadas consecutivas y
  //  consistentes entre si (a <= consistency_dist unidades) que se aceptan como teletransporte real.
  //  max_dt_s: tope del dt usado en el filtro (una pausa en las lecturas no habilita saltos grandes).
  //  history: lecturas que se recuerdan para detectar trabas.
  //  min_score: confianza minima de la lectura (las capturas reales dan 1.0; el lector ya descarta < vision.coords.min_score).
  //  Velocidad medida: el filtro mide su velocidad con las lecturas aceptadas mientras el personaje se mueve (percentil
  //  speed_percentile de las ultimas speed_window velocidades de >= speed_move_min u/s, con dt >= speed_min_dt_s; hacen
  //  falta speed_min_samples). Limite de salto = min(max_speed, max(vel_medida*speed_factor, min_speed_limit))*dt + slack;
  //  sin medicion todavia, max_speed.
  //  no_read_warn_s: segundos seguidos sin lectura buena para avisar en el log (una vez por episodio).
  //  stale_s: una ultima lectura buena mas vieja que esto se trata como "sin coordenadas" (zona desconocida).
  //  report_every_min: cada cuanto se loguea el conteo de lecturas (0 = solo al final).
  "coords_filter": {"max_speed": 30.0, "slack": 2.0, "accept_after": 3, "consistency_dist": 3.0, "max_dt_s": 0.5,
                    "history": 512, "min_score": 0.95, "speed_factor": 1.6, "min_speed_limit": 10.0, "speed_window": 30,
                    "speed_min_samples": 5, "speed_percentile": 90.0, "speed_min_dt_s": 0.2, "speed_move_min": 3.0,
                    "no_read_warn_s": 5.0, "stale_s": 3.0, "report_every_min": 5.0},

  // "No me muevo": trabado si en los ultimos window_s segundos el desplazamiento maximo es < min_move unidades
  // (solo mientras el bot intenta moverse: CoordTracker.mark_moving).
  //  max_attempts: intentos de la rutina de destrabe (clic perpendicular, clic opuesto, girar camara + clic, tecla atras).
  //  unstuck_radius_px: distancia (px) de los clics de destrabe. back_key_s: segundos de la tecla "atras" (S).
  //
  //  EPISODIOS DE TRABA (Fase 6b): la traba se abre al detectarla en cualquier estado que camina o va a un metin y persiste
  //  entre VOLVER / EXPLORAR / ATACAR / ACERCARSE / CENTRO; se cierra solo con progreso real: alejarse resolve_dist
  //  unidades del punto de traba (no 2) SIN empeorar la distancia firmada a la zona (en VOLVER / CENTRO tiene que
  //  mejorar) ni la distancia al objetivo (en ATACAR / ACERCARSE), confirmar un metin o llegar al destino (o episode_ttl_s
  //  sin intentos nuevos). progress_tol: tolerancia (unidades) de esas comparaciones.
  //  Estrategias: con >= monsters_min monstruos cerca al empezar el intento, ESPACIO (regla A) y se repite hasta fallar
  //  space_fail_max veces seguidas; sin monstruos (o con ESPACIO ya fallado) rotan MIRAR y ATRAS:
  //   ESPACIO: mantiene el ataque space_s y despues avanza (W) forward_s, en tramos de forward_chunk_s mirando las
  //     coordenadas entre tramos (no sigue si empeora hacia el limite de la zona; en la franja de tolerancia no avanza);
  //   MIRAR (regla C): gira la camara look_steps pasos de look_step_s mirando etiquetas y piedras y, si
  //     no hay nada, camina hacia una direccion >= min_dir_sep_deg distinta de las ya probadas (dir_step_deg = paso de
  //     busqueda) y, con la camara lista, hacia el interior;  ATRAS: tecla atras back_key_s y clic hacia un costado.
  //  memory_dirs: direcciones probadas que hereda el episodio siguiente si es seguido.
  //  Al agotar max_attempts en el episodio, o con repeat_max episodios en repeat_window_s -> estado CENTRO (regla D).
  //  (resolve_dist, monsters_min, space_*, forward_*, repeat_*, look_*, *_deg, episode_ttl_s: ESTIMADOS, a calibrar.)
  //  Las claves viejas stuck.max_no_progress y volver.alt_targets se ignoran con un WARNING.
  "stuck": {"window_s": 3.0, "min_move": 2.0, "max_attempts": 4, "unstuck_radius_px": 200, "back_key_s": 0.6,
            "resolve_dist": 10.0, "monsters_min": 2, "space_s": 2.0, "forward_s": 1.0,
            "repeat_max": 3, "repeat_window_s": 120.0, "look_steps": 4, "look_step_s": 0.8,
            "min_dir_sep_deg": 60.0, "dir_step_deg": 30.0, "episode_ttl_s": 120.0,
            "space_fail_max": 2, "forward_chunk_s": 0.3, "progress_tol": 1.0, "memory_dirs": 5,
            // Modo teclado (navigation.mode = "teclado"): ATRAS = S durante back_s; MIRAR = mirar con Q/E y caminar hacia la
            // direccion elegida con la combinacion de W/A/S/D mas cercana (sin girar) durante look_walk_s (los dos en tramos, con la zona chequeada entre tramos).
            "back_s": 1.0, "look_walk_s": 1.2,
            // TRABADO RAPIDO (EXPLORAR, VOLVER y CENTRO caminando; y ATACAR yendo al metin, ver attack): si deberia estar
            // moviendose (W/A/S/D sostenida, clic de ataque) y las coordenadas se mueven menos de min_move durante fast_s
            // segundos, esta trabado (objeto, borde, un bicho o un grupo). Con >= monsters_min monstruos cerca: ESPACIO
            // surrounded_space_s (montado empuja); sin monstruos: un paso al costado (attack.sidestep_s, A/D/W+A/W+D alternando).
            // Sigue en el mismo estado. Tras surrounded_max reacciones seguidas sin avanzar, el DESTRABAR de siempre.
            // Reemplaza a surrounded_s y a attack.walk_stuck_s (obsoletas: si estan en config.json se ignoran con un WARNING).
            "fast_s": 1.8, "surrounded_space_s": 1.5, "surrounded_max": 3,
            //  Trabado yendo al metin: si tras ESPACIO o el paso al costado la piedra no aparece en la captura, antes de pasar a
            //  BUSCAR mira relook_frames capturas mas y despues gira la vista relook_turn_deg hacia el lado donde estaba la piedra
            //  y, si tampoco la ve, al otro lado (0 = sin giros).
            "relook_frames": 2, "relook_turn_deg": 30.0,
            // Trabado caminando SIN monstruos en modo teclado (pared, acantilado, arbol): en vez del paso al costado se GIRA la vista
            // (detour_angles_deg respecto de donde miraba; se elige el que mas se acerca al destino, no se sale de la zona y no se
            // probo en ese lugar), se camina con W detour_s y se mira si avanza. Un rumbo que no avanza se recuerda (blocked_keep
            // lugares, a blocked_radius_u y +-blocked_tol_deg) y no se repite. Los tramos de W sin avanzar (CENTRO, VOLVER) usan la
            // misma secuencia y comparten el presupuesto surrounded_max. Sin rumbo conocido: tras probe_blind pruebas de W sin
            // medir se gira a ciegas blind_turn_deg grados y se prueba de nuevo (nunca se empuja W contra la pared con rumbo "?").
            "detour_angles_deg": [90.0, -90.0, 135.0, -135.0, 180.0], "detour_s": 2.5, "blocked_keep": 12,
            "blocked_radius_u": 15.0, "blocked_tol_deg": 40.0, "probe_blind": 2, "blind_turn_deg": 120.0},

  // Loop principal (bot/bot.py). cycle_ms: ritmo minimo de un ciclo (captura + decision). captcha_full_search_every:
  // cada N ciclos el captcha se busca en toda la imagen (respaldo de la zona fija). hold_chunk_s: las teclas sostenidas
  // (ESPACIO, W, S, giros de camara) se parten en tramos de este largo con un chequeo de captcha (captura + zona fija,
  // ~3 ms) entre tramos: si aparece, se suelta todo y pasa a CAPTCHA enseguida.
  "loop": {"cycle_ms": 150, "captcha_full_search_every": 10, "hold_chunk_s": 0.5},

  // ATACAR. confirm_timeout_s: tiempo sin ver el panel del metin (ni moverse) antes de reclickear.
  //  hp_stall_s: la vida no baja por tanto tiempo -> reclic. max_reclicks: mas que esto -> descartar el metin.
  //  max_seconds: tope total de un ataque; pasado ese tope, un metin con la vida por debajo de max_seconds_keep_hp (0.20 =
  //  20%) NO se abandona: reclic en el metin (cada reclick_wait_s si la vida no baja) y se sigue. broken_confirm_cycles: ciclos seguidos sin panel (o con vida 0) para dar el
  //  metin por roto. discard_minutes: un metin descartado no se vuelve a elegir por ese tiempo.
  //  discard_radius: unidades del juego a la redonda que se consideran "el mismo metin".
  //  discard_error_frac: se suma al radio esta fraccion de la distancia al metin (el error de la camara crece con la distancia).
  //  Sin camara calibrada el descarte se guarda con la posicion del JUGADOR y solo aplica cerca de ese lugar (ver approach.blind_*).
  //  max_wrong_selections: veces que un mismo metin selecciona otra cosa (monstruo, NPC) antes de descartarlo.
  //  Regla B (ESTIMADOS): blocked_s = confirmado, la vida no baja por tanto tiempo y el personaje esta quieto o gira en
  //  circulo (recorrido en la ventana > circle_ratio x desplazamiento neto, con al menos circle_min_path unidades) ->
  //  ESPACIO (stuck.space_s) y reclic en el metin (cuenta como reclic). Seleccion equivocada de un monstruo (panel "other")
  //  con >= wrong_monsters_min monstruos cerca (o bichos encima, ver vision.monsters.on_me_px) -> ESPACIO y clic directo en
  //  el metin (SIN Escape); sin bichos, clic directo en el metin (sigue contando para max_wrong_selections).
  //  blocked_window_frac: fraccion de blocked_s que tiene que cubrir el recorrido para juzgar si esta bloqueado.
  //  Si el personaje sale de la zona atacando un metin cuya posicion queda afuera (o no se conoce), esa posicion se descarta.
  //  Metin lejano: tras el clic el personaje camina solo. Mientras sus coordenadas cambian no cuenta el estancamiento de
  //  vida (hp_stall_s) hasta walk_max_s. Quieto stuck.window_s con la vida sin bajar y >= stuck.monsters_min monstruos cerca
  //  -> ESPACIO unstick_space_s y reclic (cuenta para max_reclicks). (walk_max_s, unstick_space_s: ESTIMADOS.)
  "attack": {"confirm_timeout_s": 6.0, "hp_stall_s": 8.0, "max_reclicks": 3, "max_seconds": 120.0, "max_seconds_keep_hp": 0.20,
             "broken_confirm_cycles": 2, "discard_minutes": 10.0, "discard_radius": 8.0, "discard_error_frac": 0.3,
             "max_wrong_selections": 3, "blocked_s": 4.0, "circle_ratio": 2.5, "circle_min_path": 4.0,
             "wrong_monsters_min": 1, "blocked_window_frac": 0.8,
             "walk_max_s": 25.0, "unstick_space_s": 1.5,
             //  ROTO REAL (un metin de 80.000 de vida no cae en 20 s): solo cuenta como roto si el panel desaparece con la
             //  ultima vida leida <= broken_hp_ratio, la piedra ya no se ve (ni etiqueta ni piedra lejana) a <= broken_gone_px
             //  de su ultimo punto de pantalla durante broken_confirm_cycles ciclos, y pasaron >= min_break_s desde que se
             //  confirmo el ataque. Vida baja pero la piedra sigue ahi: espera broken_wait_s y reclic. Panel perdido con vida
             //  alta = DESELECCION (clic en un bicho): reclic en el mismo metin, hasta max_deselect_reclicks; despues BUSCAR
             //  (con el metin en curso; a la segunda vez se descarta). reclick_wait_s: gracia tras un reclic antes de juzgar
             //  el panel de nuevo. El mapa de metin y el contador solo suben con roturas reales.
             "broken_hp_ratio": 0.10, "broken_gone_px": 90, "min_break_s": 15.0, "broken_wait_s": 3.0,
             "max_deselect_reclicks": 6, "reclick_wait_s": 1.0,
             //  NO RECLICKEAR SI PEGA: si la vida bajo en los ultimos hp_progress_s no se hace ningun clic. Vida quieta
             //  reclick_stall_s -> reclic. El reclic va al punto del cuerpo de la piedra mas alejado de las etiquetas de
             //  monstruos (descarta los a <= monster_clear_px); clear_offsets_px = desplazamientos [dx, dy] candidatos
             //  respecto del punto de clic. (hp_stall_s ya no se usa: lo reemplaza reclick_stall_s.)
             "hp_progress_s": 4.0, "reclick_stall_s": 5.0, "monster_clear_px": 25,
             "clear_offsets_px": [[0, -15], [0, 15], [0, 25], [-15, 0], [15, 0], [-25, 0], [25, 0], [-15, 15], [15, 15], [-15, -15],
                                  [15, -15]],
             //  TRABADO YENDO AL METIN: tras el clic, coordenadas quietas (< stuck.min_move) stuck.fast_s con la vida sin bajar
             //  -> con >= stuck.monsters_min monstruos cerca ESPACIO unstick_space_s + reclic en el mismo metin; sin monstruos
             //  un paso al costado (A, D, W+A, W+D, alternando) de sidestep_s + reclic; hasta max_unstick intentos y recien ahi
             //  DESTRABAR. No se juzga con la camara girada ni con la vida bajando; arrive_px: confirmado y con la piedra a
             //  esa distancia (px) del personaje ya llego, quieto es normal. (walk_stuck_s es obsoleta: ahora es stuck.fast_s.)
             "sidestep_s": 0.6, "max_unstick": 4, "arrive_px": 120,
             //  PUNTO DE CLIC EN EL CUERPO DE LA PIEDRA: el de la etiqueta (vision.metin.click_dy debajo de ella) cae en la base
             //  o en el piso; se corre hacia arriba label_click_up_frac * click_dy px (medido: la piedra lejana queda ~45 px
             //  debajo del centro de la etiqueta, click_dy 65). Con una piedra lejana asociada se usa el centro de su rect.
             //  VERIFICACION RAPIDA: a los confirm_wait_s del clic sin panel de metin (ni de otra cosa), reclic mejor apuntado
             //  (piedra/etiqueta relocalizada; si cae en el mismo punto, quick_up_px mas arriba por intento), hasta quick_reclicks;
             //  despues el flujo de siempre (confirm_timeout_s). No cuentan para max_reclicks.
             "label_click_up_frac": 0.37, "confirm_wait_s": 1.5, "quick_reclicks": 2, "quick_up_px": 10,
             //  RITMO DE CLICS: ningun clic izquierdo de ataque a menos de min_click_gap_s del anterior ni con el personaje en
             //  movimiento (coordenadas cambiando); sin confirmar, otro clic recien despues de confirm_wait_s. name_gap_px: el
             //  clic cae siempre a mas de tantos px debajo del nombre de la etiqueta (nunca sobre el nombre ni la franja de arriba).
             //  PANEL AUSENTE (error del juego: a veces atacando un metin no aparece la barra de vida): quieto y pegado, sin
             //  panel y con un monstruo cerca, con panel_recover se hace UN clic derecho (apretar y soltar, sin mover la
             //  camara) sobre el cuerpo del monstruo por episodio; el juego muestra su nombre y vida y, si se esta atacando un
             //  metin, el panel vuelve a mostrar la vida del metin. Si en recover_wait_s no vuelve: no ataca, clic izquierdo al
             //  metin. La senal por animacion del arma no esta implementada (no es confiable sin secuencias etiquetadas).
             "min_click_gap_s": 1.5, "name_gap_px": 20, "panel_recover": true, "recover_wait_s": 1.5,
             //  METIN EN CURSO (clickeado/seleccionado/atacado, no roto): no se elige otro. Si se pierde de vista se lo busca a
             //  <= relocate_px de su ultimo punto de pantalla (camara sin girar) o por su posicion estimada; si no aparece en
             //  target_keep_s se lo suelta.
             "relocate_px": 150, "target_keep_s": 25.0,
             //  keep_with_others_s: si el metin en curso no se ve y hay OTRO metin objetivo con etiqueta a la vista, se lo
             //  suelta a los keep_with_others_s en vez de target_keep_s. Solo hay metin en curso si el panel lo confirmo.
             "keep_with_others_s": 8.0,
             //  Buscar el proximo metin MIENTRAS se ataca: con scan_enabled, la vida del metin bajando desde hace scan_after_s y el
             //  panel confirmado, la camara gira de a un paso de Q/E (explore.camera_step_s) hasta scan_steps pasos o hasta ver un
             //  metin objetivo (distinto del que se ataca) y vuelve la misma cantidad de pasos a su posicion original. Entre paso y
             //  paso espera la compuerta explore.settle_s / settle_frames y comprueba que la vida siga bajando: si un giro corta el
             //  ataque (la vida deja de bajar hp_progress_s + scan_hp_margin_s), vuelve la camara, avisa y no busca mas mientras ataca en esta
             //  corrida. NUNCA hace clic en otro metin hasta romper el actual y recoger. Lo encontrado se recuerda next_keep_s
             //  segundos: al terminar RECOGER gira esos pasos y va directo a el (a <= relocate_px del punto recordado).
             "scan_enabled": true, "scan_after_s": 5.0, "scan_steps": 12, "next_keep_s": 60.0,
             "scan_hp_margin_s": 2.0,
             //  BICHOS ENCIMA (nombres rojos solapados o a <= vision.monsters.on_me_px del nombre amarillo del personaje): panel
             //  perdido / seleccion equivocada / trabado -> ESPACIO (on_me_space_s en la deseleccion) antes del reclic.
             //  PIEDRA TAPADA: dos panel perdidos seguidos con vida alta (lost_swap_after) -> el reclic va a otro punto candidato
             //  de la parte visible de la piedra (vision.click_point), no al mismo.
             //  TRAS UN CAPTCHA: se retoma el metin que se atacaba (su punto de pantalla y su posicion en el mapa; si el personaje
             //  seguia caminando hacia el, la etiqueta mas cercana que ya esta tan cerca o mas que al hacer el clic) y durante
             //  after_captcha_keep_s no se lo suelta por "hay otro objetivo a la vista" (solo por target_keep_s).
             "on_me_space_s": 1.0, "lost_swap_after": 2, "after_captcha_keep_s": 20.0},

  // RECOGER. Al romperse el metin se mira hasta look_s segundos si hay objetos validos en el piso (no yang, no reservados
  //  para otro). Sin objetos: sigue directo a BUSCAR (no se baja). Con objetos: se baja del caballo (si dismount) y, para
  //  cada objeto (el mas cercano al personaje primero), camina hasta el y aprieta Z, hasta que no queden.
  //  dismount: true = se baja del caballo para recoger y se sube al terminar; false = recoge montado (mismo flujo).
  //  mount_wait_s: espera tras cada Ctrl+G (se vigila el captcha).
  //  SIN clics: despues de bajarse, camina con W/A/S/D hasta quedar encima de cada objeto. Elige el mas cercano (distancia
  //  de piso) y NO lo cambia hasta que desaparece o se abandona. Toma su direccion sobre el piso desde los pies, la parte
  //  en 8 sectores de 45 grados (W, W+D, D, S+D, S, S+A, A, W+A) y mantiene esas teclas un tramo de step_s (proporcional
  //  a la distancia si esta a menos de full_step_px, minimo min_step_s); despues vuelve a mirar. El punto del objeto =
  //  centro inferior de su etiqueta + item_below_label_px. arrive_px: llegada = ese punto a <= arrive_px de los pies.
  //  Ya encima: Z cada z_interval_s (la Z del servidor tiene retraso) mientras la etiqueta siga; desaparecida =
  //  gone_cycles capturas seguidas sin verla cerca de su ultimo punto (track_px) -> recogido, sigue el proximo. Tras
  //  reposition_after_z Z sin que desaparezca, se reacomoda: UN tramo hacia su punto exacto si esta a mas de arrive_px *
  //  reposition_frac, y sigue con Z. Tras max_z_per_item Z (reacomodo incluido) se SALTEA ese objeto y sigue con los demas
  //  (tambien a los item_max_s desde que empezo con el, p. ej. si no lo alcanza). Un salteado no se vuelve a recoger: se lo
  //  reconoce por su posicion en el mapa (a <= skip_match_u, con el rumbo de la camara) o, sin rumbo, por su punto de
  //  pantalla (a <= same_px) mientras el personaje no se mueva same_spot_u unidades. Antes de subirse al caballo espera final_look_s, mira
  //  una ultima captura y recoge lo que haya quedado (sin los salteados). Si sale de la zona se corta la recogida. Se sube al caballo solo cuando no queda
  //  ningun objeto valido durante empty_confirm_cycles ciclos, o por max_presses Z o max_seconds (desde que empieza a
  //  recoger). (arrive_px, step_s, full_step_px, reposition_*, item_max_s: ESTIMADOS.)
  "pickup": {"z_interval_s": 0.4, "empty_confirm_cycles": 5, "max_presses": 200, "max_seconds": 90.0,
             "dismount": true, "mount_wait_s": 2.0, "look_s": 1.0, "arrive_px": 70, "item_below_label_px": 10,
             "step_s": 0.25, "min_step_s": 0.1, "full_step_px": 200, "track_px": 80, "same_spot_u": 3.0,
             "gone_cycles": 2, "reposition_after_z": 1, "reposition_frac": 0.5, "item_max_s": 15.0,
             "max_z_per_item": 4, "skip_match_u": 4.0, "final_look_s": 0.5,
             //  Objetos primero: buscando, explorando o yendo a otro metin, un objeto valido a <= priority_px (de pantalla) del
             //  personaje que no se salteo pasa a RECOGER antes que cualquier otra cosa (nunca se elige un metin nuevo con
             //  objetos sin intentar). Los salteados se recuerdan skip_keep_s. Antes de subirse al caballo se guarda en
             //  debug/<run>/recoger/ una captura completa (HHMMSS_mmm_antes_de_subir.png), con debug.enabled.
             "priority_px": 450, "skip_keep_s": 300.0,
             //  idle_max_s: recogiendo sin que desaparezca ningun objeto por tanto tiempo, termina (los que quedan cuentan como
             //  intentados). priority_retry_s: tras una recogida cortada (sin progreso, tope de Z o de tiempo, fuera de la zona),
             //  "objetos primero" espera esto antes de volver a entrar.
             "idle_max_s": 20.0, "priority_retry_s": 60.0,
             //  skip_crop_px: con debug.enabled, cada objeto salteado (tras max_z_per_item Z o item_max_s) deja un recorte en
             //  debug/<run>/recoger/HHMMSS_mmm_salteado_<x>_<y>.png: [medio ancho, arriba, abajo] en px alrededor del objeto.
             "skip_crop_px": [160, 110, 90],
             //  Cada Z junta el objeto MAS CERCANO al personaje: same_px = radio para decir que una etiqueta es el mismo objeto entre
             //  capturas (sin caminar); near_px = un objeto que desaparece a menos de esto de los pies cuenta como recogido si hubo
             //  un Z en los ultimos progress_window_s; switch_ratio = el objeto actual cambia al mas cercano solo si este esta a menos
             //  de esta fraccion de su distancia (histeresis).
             "same_px": 25, "near_px": 160, "progress_window_s": 3.0, "switch_ratio": 0.6},

  // EXPLORAR (regla E): barrido de camara (camera_steps pasos de camera_step_s con Q o E, deberian dar ~360 grados;
  //  se mira etiquetas y piedras lejanas despues de cada paso), tramo recto, parar, barrido, otra direccion...
  //  border_margin: el destino de cada tramo queda a >= esta distancia del borde (y los destinos de vuelta). leg_units /
  //  leg_s: largo (unidades) y tope de tiempo de un tramo. min_leg_sep_deg / recent_legs: el rumbo nuevo se aparta tanto
  //  de los ultimos rumbos. max_without_metin_s: sin ningun objetivo por tanto tiempo -> CENTRO.
  //  walk_timeout_s: tope de un tramo de VOLVER/CENTRO. (camera_steps, border_margin, leg_*, max_without_metin_s: ESTIMADOS.)
  //  visited_keep: puntos recientes que la exploracion trata de no repetir. leg_tiebreak_units: desempate al azar
  //  (unidades) entre destinos de tramo parecidos.
  //  settle_s / settle_frames: el barrido (y el giro de MIRAR) gira en pasos y despues de cada uno espera este tiempo Y
  //  esta cantidad de percepciones completas antes del siguiente (para analizar lo que aparecio). (ESTIMADOS.)
  //  edge_return_u: adentro a menos de esto del borde con el tramo alejandose del poligono -> VOLVER al centro; igual si
  //  termino un barrido completo sin ver nada util estando a menos de border_margin del borde. VOLVER/CENTRO se guian solo
  //  por las coordenadas (W/A/S/D), aunque la imagen no muestre referencias.
  "explore": {"camera_steps": 12, "camera_step_s": 0.5, "walk_timeout_s": 20.0, "border_margin": 25.0,
              "leg_s": 10.0, "leg_units": 45.0, "max_without_metin_s": 90.0, "min_leg_sep_deg": 60.0,
              "recent_legs": 3, "visited_keep": 8, "leg_tiebreak_units": 3.0,
              "settle_s": 0.6, "settle_frames": 2, "edge_return_u": 5.0,
              "sweep_deg": 325.0, "sweep_max_factor": 1.5,
              //  Paso de la vuelta: sweep_step_deg grados por giro (campo de vision horizontal estimado ~70 grados: 30 grados deja
              //  ~57% de superposicion); se analiza en cada paso. Metin con nombre objetivo "cerca" (approach.near_floor de piso o
              //  menos): se ataca ya, sin terminar la vuelta. Solo las piedras cerca se confirman con hover (hasta sweep_max_hovers
              //  por vuelta); las lejanas quedan en la lista sin confirmar.
              "sweep_step_deg": 30.0, "sweep_max_hovers": 6, "aim_tol_deg": 12.0, "aim_max_turns": 4,
              "candidate_keep_s": 180.0, "candidate_merge_u": 12.0, "candidate_tie_u": 4.0, "candidate_max_u": 200.0,
              "candidate_walk_u": 30.0, "candidate_walk_tries": 2, "candidate_broken_u": 20.0,
              "center_return_u": 25.0, "center_laps": 2, "ground_scale_u": 13.0, "ground_scale_ema": 0.3,
              "ground_scale_bounds": [0.4, 2.5], "ground_reach_u": 4.0},
  //  UNA VUELTA (con el rumbo de la camara leido del cono del minimapa, vision.minimap): el barrido gira en pasos hasta sweep_deg
  //  grados acumulados (tope: camera_steps * sweep_max_factor pasos) y arma la LISTA de candidatos con su posicion en el MAPA
  //  (coordenadas del juego: jugador + ground_scale_u x vector de piso girado al rumbo de la camara). Al terminar elige el
  //  mas cercano (etiqueta o piedra) y, a igual distancia (candidate_tie_u), el mas cerca del centro de la zona; solo dentro de la zona o la tolerancia. Gira directo hacia el (aim_tol_deg, hasta aim_max_turns giros, mide el rumbo
  //  logrado con el minimapa), espera la compuerta y va al candidato de pantalla mas cercano a la posicion esperada; si no
  //  aparece camina candidate_walk_u hacia el (candidate_walk_tries veces) y vuelve a mirar. No hay otra vuelta mientras la lista
  //  tenga candidatos (candidate_keep_s de vigencia; se borran los que caen a candidate_broken_u de un metin roto). Un metin
  //  objetivo con nombre a approach.near_floor de piso o menos corta la vuelta (o el giro hacia un candidato) y se ataca ya. Vuelta sin nada: va al
  //  punto listo del mapa de metin (hora desconocida = lista) o, si no hay, al centro (si esta a mas de center_return_u); se camina
  //  hasta llegar (arrive_u / navigation.arrive_dist) y recien ahi se busca. Ya en el centro y sin nada: otra vuelta alli, hasta
  //  center_laps seguidas; despues, un tramo al azar. Sin cono legible se usa el rumbo estimado por el movimiento.
  //  ground_scale_u (ESTIMADO de events.log/bot.log del 2026-11-20: 10-20 u por unidad de piso, mediana ~13) se afina solo
  //  (EMA ground_scale_ema, acotado a ground_scale_bounds x el inicial) con cada clic que lleva al personaje a un metin
  //  (recorrido + ground_reach_u). Sin cono legible el bot vuelve al comportamiento anterior (varias vueltas, "_next").

  // Angulo vertical de la camara (bot/camera_pitch.py). Con enabled false el bot NO toca la camara (ni al arrancar ni despues de
  //  cada metin): para farmear con la camara acomodada a mano. Reinicio con TECLAS (sin arrastres del mouse ni medir el angulo):
  //  (a) rueda hacia "lejos" zoom_out_clicks (zoom_out_sign = sentido de la rueda que ALEJA: 1 = hacia adelante, -1 = hacia
  //  atras; en Guabina tools/prueba_camara.py mostro que 1 ACERCA, asi que alli va -1); (b) mantener G (controls.camera_top) g_hold_s hasta el tope de la vista
  //  desde arriba; (c) t_taps toques CORTOS de T (controls.camera_flat, t_tap_ms cada uno medido con reloj de alta precision,
  //  t_gap_ms entre toques; el log dice cuanto duro cada uno) hasta el
  //  angulo de farmeo: nunca T mantenida (llega a plano y la camara se ACERCA al personaje; ese zoom solo se saca con la rueda);
  //  (d) rueda hacia "lejos" otra vez, por seguridad. step_pause_s: pausa entre pasos. t_taps se calibra con
  //  `calibrate.py camara` (guiado: toca T de a uno y pregunta).
  //  Cuando: SOLO cuando el terreno movio la camara (mira el piso: floor_frames capturas seguidas sin horizonte mientras se
  //  busca), con al menos min_gap_s (60) desde el reinicio anterior, que se multiplica si el reinicio no saco la vista del piso.
  //  No se reinicia al arrancar (la camara se deja acomodada antes de empezar) ni despues de cada metin. Nunca mientras ataca,
  //  recoge o hay captcha.
  //  Detector de "mira el piso" (bot/vision/pitch.py, solo como detector): min_confidence, strip_half_frac, sample_*,
  //  player_box_px, tol_*, min_sat, row_floor_frac, run_rows, min_valid_px, min_floor_rows, side_offset_frac, side_half_frac.
  //  (limit, to_limit_px, from_limit_px, *drag*, step_px, calib_max_px: del metodo de topes con arrastre, ya no se usan.)
  "camera_pitch": {"enabled": true, "zoom_out_clicks": 20, "zoom_out_sign": 1, "g_hold_s": 3.0, "t_taps": 4, "t_tap_ms": 120,
                   "t_gap_ms": 200, "step_pause_s": 0.3, "floor_frames": 2, "min_gap_s": 60.0,
                   "side_offset_frac": 0.14, "side_half_frac": 0.06,
                   "min_confidence": 0.5,
                   "strip_half_frac": 0.12, "sample_top_px": 70, "sample_bottom_px": 170, "player_box_px": [110, 140, 130],
                   "tol_hue": 10, "tol_val": 22, "min_sat": 10, "row_floor_frac": 0.5, "run_rows": 8,
                   "min_valid_px": 20, "min_floor_rows": 40},

  // ACERCARSE: confirmar el tipo de una piedra lejana (sin etiqueta) con HOVER. Entra desde BUSCAR/EXPLORAR cuando la
  //  piedra elegida (la mas cercana al personaje, ver vision.ground) no tiene etiqueta: mueve el mouse sobre su cuerpo
  //  (sin clic), espera hover_wait_s y busca una etiqueta a <= hover_label_px de la piedra. Etiqueta objetivo -> clic y
  //  ATACAR (el personaje camina solo hasta la piedra); etiqueta de otro tipo -> esa posicion se ignora ignore_minutes
  //  (radio ignore_radius, mas el error de la camara) y vuelve a BUSCAR; sin etiqueta tras hover_tries hovers -> clic
  //  igual (el panel de ATACAR confirma el tipo). No gira la camara ni camina con W.
  //  lost_cycles ciclos sin ver la piedra -> BUSCAR (SIN ignorarla). max_seconds: tope de todo el acercamiento.
  //  label_match_px: una etiqueta a esa distancia de la piedra es "esa piedra". match_px: seguimiento entre ciclos.
  //  label_exclude_down_px: la piedra de una etiqueta visible (hasta tantos px debajo de ella) no es "lejana".
  //  max_tries_per_spot: aproximaciones a una misma posicion sin llegar a atacar antes de ignorarla (se reinicia al atacar).
  //  SIN CAMARA LISTA (no se sabe donde esta el metin en el juego; es lo normal en modo teclado): un metin (con etiqueta
  //  o piedra) se ataca/persigue si el personaje esta adentro del poligono o en la franja de tolerancia (no mas afuera),
  //  sin limite de distancia en pantalla (la clave vieja approach.blind_screen_px se ignora).
  //  Un descarte o ignorado se guarda con la posicion del JUGADOR y solo aplica a menos de blind_player_radius
  //  unidades de ese lugar (y a lo que se ve en el mismo sitio de la pantalla), no a todo.
  //  far_monsters_n / far_monsters_px: una piedra lejana SIN humo (criterio secundario) con >= n etiquetas de monstruos a
  //  menos de px de ella es un falso positivo (un grupo de bichos) y se ignora. Las que tienen humo no se filtran.
  "approach": {"max_seconds": 40.0, "ignore_minutes": 10.0, "ignore_radius": 10.0, "lost_cycles": 6,
               "label_match_px": 100, "match_px": 200, "label_exclude_down_px": 100,
               "blind_player_radius": 25.0, "max_tries_per_spot": 3,
               //  Regla de zona de los metin: con posicion conocida solo se va a los que quedan a <= metin_outside_u afuera
               //  del borde (menos que outside_tolerance). Sin posicion (camara no lista): solo si estan a distancia de piso
               //  <= blind_near_floor (unos pocos pasos) y el jugador esta adentro a >= blind_inside_margin del borde.
               //  Excepcion: un metin objetivo CON etiqueta a piso <= near_floor se ataca aunque el jugador este cerca del borde
               //  (o se perdieron las coordenadas un momento), si el metin queda adentro de la zona mas farm_zone.outside_tolerance
               //  (posicion por el rumbo del minimapa; sin rumbo, el peor caso).
               "blind_near_floor": 3.0, "blind_inside_margin": 15.0, "metin_outside_u": 15.0,
               "far_monsters_n": 2, "far_monsters_px": 200,
               "hover_wait_s": 0.3, "hover_label_px": 120, "hover_tries": 2,
               //  ACERCARSE CON TECLADO (navigation.mode = teclado): a mas de near_floor (distancia de piso) del metin elegido se
               //  alinea la vista con Q/E hasta que la piedra quede a <= center_tol_px del centro horizontal, se camina con W en
               //  tramos de walk_chunk_s re-detectando la piedra y se FRENA al llegar a near_floor. Quieto (quiet_reads
               //  lecturas de coordenadas iguales y settle_s sin teclas) se vuelve a ubicar la piedra en la captura nueva y se hace
               //  UN clic en el centro de su cuerpo. Sin confirmar: otro clic quieto; a los max_clicks se elige otro (la posicion
               //  se ignora retry_ignore_s, no se descarta). align_turns_max giros seguidos sin centrar: se camina igual.
               //  Tramos de W sin avanzar: con bichos ESPACIO; sin bichos se cancela el acercamiento (o clic si ya
               //  esta a <= stuck_click_floor). keys_enabled=false vuelve al clic que camina solo.
               //  near_floor: metin objetivo "cerca" (distancia de piso). Durante la vuelta de busqueda o al girar hacia un
               //  candidato, uno con nombre a esta distancia o menos se ataca en ese momento, aunque haya otros o falte vuelta;
               //  en pantalla se le hace clic directo, sin girar la vista para centrarlo.
               "near_floor": 4.0,
               "keys_enabled": true, "center_tol_px": 140, "walk_chunk_s": 0.5, "quiet_reads": 2,
               "settle_s": 0.4, "max_clicks": 4, "retry_ignore_s": 30.0, "align_turns_max": 6,
               "stuck_click_floor": 4.0,
               //  ELECCION: una etiqueta objetivo va antes que una piedra sin etiqueta, salvo que la distancia de piso de la
               //  piedra sea < unlabeled_closer_ratio x la de la etiqueta. Las piedras sin etiqueta con la base por debajo de
               //  near_unlabeled_y_frac del alto (cerca del personaje: de cerca los metin siempre muestran su nombre, asi que
               //  casi seguro es un monstruo) van al final y solo se consideran si no hay otro candidato.
               //  HOVER sin nombre tras hover_tries (ya NO hay clic): se ignora esa posicion no_label_ignore_s segundos.
               "unlabeled_closer_ratio": 0.5, "near_unlabeled_y_frac": 0.55, "no_label_ignore_s": 120.0},

  // CENTRO (regla D / E): como VOLVER pero el destino es el centro del poligono; termina a <= arrive_dist unidades y
  //  sigue con barrido + EXPLORAR. Su tope de tiempo y sus episodios de traba son los de VOLVER (volver.max_seconds).
  "center": {"arrive_dist": 8.0},

  // VOLVER (hacia el centro). max_seconds: tiempo acumulado de una misma "vuelta" (se reinicia al volver a quedar adentro);
  //  al superarlo el bot termina con "no puede volver a la zona" (en CENTRO, "no puede llegar al centro") y suena la alarma.
  "volver": {"max_seconds": 120.0},

  // CAPTCHA (el bot NO lo resuelve): suelta todo, suena la alarma y espera. Lee la pantalla cada poll_s sin traer el juego
  //  al frente (solo si ya esta adelante). clear_confirm lecturas seguidas sin panel -> para la alarma y sigue.
  "captcha_wait": {"poll_s": 0.5, "clear_confirm": 2},

  // Navegacion por realimentacion (bot/navigation.py). Pantalla en px, juego en unidades de coordenadas.
  //  probe_radius_px: distancia del clic de sondeo (camara sin calibrar). click_radius_px: [min, max] del clic de caminata (el clic mide la distancia al destino, hasta max; si hay que
  //  acortarlo por la mascara no baja de min; cerca del destino se acorta hasta el, nunca menos de min_segment_px).
  //  arrive_dist: llego si esta a <= N unidades. explore_margin: margen al borde del poligono para puntos de exploracion.
  //  min_segment_px / min_segment_game: tramos mas cortos se ignoran (bloqueados o ruido de redondeo).
  //  min_sin: seno minimo del angulo entre dos tramos para aprender la camara (no colineales).
  //  fit_segments: tramos usados en el ajuste. max_ratio_error: un tramo cuya longitud difiere mas de esta fraccion
  //  de la esperada se descarta (bloqueado); tras relearn_after_rejects descartes seguidos se reaprende todo.
  //  phi_smooth_deg: si el giro nuevo difiere menos de esto se promedia con el anterior.
  //  angle_step_deg / max_angle_deg: si el punto de clic no esta permitido, se prueban angulos +-step hasta max.
  //  shorten_factors: distancias relativas a probar (1.0 = completa) para cada angulo.
  "navigation": {
    "probe_radius_px": 150, "click_radius_px": [60, 120], "arrive_dist": 5.0, "explore_margin": 15.0,
    "min_segment_px": 20, "min_segment_game": 8.0, "min_sin": 0.3, "fit_segments": 8,
    "max_ratio_error": 0.35, "relearn_after_rejects": 4, "phi_smooth_deg": 10.0,
    "angle_step_deg": 15, "max_angle_deg": 60, "shorten_factors": [1.0, 0.75, 0.5],
    // settle_s: sin cambio de coordenadas por tanto tiempo = el personaje se freno (fin del tramo).
    // segment_timeout_s: tope de un tramo caminado.
    "settle_s": 1.0, "segment_timeout_s": 8.0,
    // avoid_metin_px: los clics de caminata y destrabe no caen a menos de N px de un metin que NO es objetivo
    // (clickearlo lo ataca). 0 = desactivado.
    "avoid_metin_px": 70,
    // scale_hint: rango plausible de la escala pantalla->juego [menor, mayor] (unidades por px). Solo acorta los
    // sondeos cerca del borde de la zona mientras la camara no esta calibrada.
    "scale_hint": [0.15, 0.4],
    // Giro externo de la camara (no hecho por el bot). external_rotation_deg: si el giro estimado cambia mas que esto con
    // un tramo consistente, se avisa y se re-estima. heading_tolerance_deg: rumbo observado vs esperado durante un tramo
    // (2 ciclos seguidos fuera -> se corta el tramo y se invalida el giro). zone_guard_margin: el tramo se corta si el
    // personaje baja de -(outside_tolerance - margen). max_walk_px: largo maximo de un tramo (tambien de sondeos y destrabes).
    // brake_px: distancia del clic de freno al cortar un tramo. La guardia de zona vale para TODOS los tramos (tambien
    // sondeos y destrabes): se corta si el personaje esta mas alla de ese umbral fijo y la distancia no mejora.
    "external_rotation_deg": 25.0, "heading_tolerance_deg": 30.0, "zone_guard_margin": 10.0,
    "max_walk_px": 120, "brake_px": 12,
    // Sondeos (camara sin calibrar). probe_measure_factor: holgura sobre el largo minimo para poder medir un tramo
    // (cerca del borde el sondeo se acorta por debajo de eso, sin piso). probe_turn_jitter_deg: variacion al azar del
    // giro de ~90 grados entre sondeos.
    "probe_measure_factor": 1.5, "probe_turn_jitter_deg": 17.0,
    // mode: "teclado" (por defecto) = el bot camina SOLO con W/A/S/D (8 direcciones: W, W+D, D, S+D, S, S+A, A, W+A) sin
    // girar la camara; Q/E solo sirven para mirar (barridos, MIRAR). El clic izquierdo queda para atacar un metin.
    // "clic" = caminar con clics en el piso (modo anterior, con la camara aprendida).
    "mode": "teclado",
    // Modo teclado (bot/keynav.py). cam_h = hacia donde camina W en el juego: sale del cono del minimapa (mismo marco que las
    // coordenadas) y, si no se lee, del desplazamiento medido en cada tramo. Con lateral=false (por defecto) el bot camina SOLO
    // con W y alinea la vista con Q/E (align_deg); con lateral=true elige entre 8 combinaciones (W 0, W+D +45, D +90, S+D +135,
    // S 180, S+A -135, A -90, W+A -45). En las capturas reales A/D giran la vista (~36 grados/s), por eso lateral es false.
    // chunk_s: tramo de caminata entre chequeos; probe_s: W de prueba para medir cam_h cuando no se conoce; align_deg y
    // max_turn_deg: solo para giros de la vista; turn_deg_per_s: velocidad inicial de giro de Q/E (= 360 /
    // (explore.camera_steps * explore.camera_step_s)), se aprende;
    // walk_speed: velocidad inicial de caminata en unidades/s, tambien se aprende; min_step_s: tramo minimo;
    // edge_measure_u: desplazamiento minimo para medir cam_h cuando el personaje ya paso la guardia de zona (ahi no hay
    // lugar para tramos largos).
    // SENTIDOS FIJOS: view_right_key = tecla (camera_left o camera_right) que gira la VISTA a la derecha; ad_side = "normal"
    //  (D va a la derecha de W) o "reverso". Con "auto" (por defecto) se determinan UNA vez con senses_votes muestras
    //  coherentes (sin fijar se asume camera_right y "normal"), se guardan en senses_file (se reusan en la proxima corrida) y
    //  quedan fijos: la evidencia contraria solo avisa, nunca invierte. Ponerlos a mano los fija desde el arranque.
    "keyboard": {"chunk_s": 0.5, "probe_s": 0.4, "align_deg": 20.0, "turn_deg_per_s": 60.0, "max_turn_deg": 180.0,
                 "walk_speed": 15.0, "min_step_s": 0.15, "edge_measure_u": 3.0, "view_right_key": "auto",
                 "ad_side": "auto", "lateral": false, "senses_votes": 3, "senses_file": "logs/sentidos.json"}
  },

  "vision": {
    // Plano del piso (bot/ground.py): compara distancias con perspectiva (mas abajo y mas grande = mas cerca) para elegir
    //  el metin mas cercano. horizon_frac: fila del horizonte (fraccion del alto); focal_frac: focal (fraccion del ancho);
    //  feet_dy_px: los pies del personaje quedan tanto debajo de su punto; min_dv_px: acota (fila - horizonte) abajo.
    //  ESTIMADOS: verificados con samples/real_tres_metin_hover.png; el orden no cambia con horizon_frac 0.10-0.19.
    "ground": {"horizon_frac": 0.14, "focal_frac": 0.7, "feet_dy_px": 40, "min_dv_px": 20},
    // Rumbo de la camara desde el cono (abanico mas claro) del minimapa (bot/vision/minimap.py). Medido en
    //  debug/run_20261120_121005: el minimapa tiene el norte fijo, el personaje esta en (ancho + center_dx, center_dy) y el cono
    //  mide ~40 grados (~20 a pie). Se muestrea cada step_deg entre r_min y r_max px (sin pixeles rojos ni V < min_val, min_samples
    //  validos por rayo); cono = arco con exceso de V sobre la mediana > max(min_excess, rel_frac x percentil 95) y ancho
    //  width_deg [min, max]; si no lee hay un segundo pase relajado (umbrales x relax_factor, ancho relax_width_deg).
    //  El rumbo es atan2(dy, dx) con y hacia abajo (0 = este), el MISMO marco de las coordenadas (sin espejo; medido en
    //  debug/run_20261121_205635). heading_offset_deg = 0; el bot lo afina solo con tramos de W (EMA offset_ema, tope +-offset_max_deg).
    "minimap": {"center_dx": -68, "center_dy": 68, "r_min": 14, "r_max": 50, "step_deg": 2.0, "min_val": 50,
                "min_samples": 6, "min_excess": 18.0, "rel_frac": 0.45, "width_deg": [12.0, 70.0],
                "relax_factor": 0.5, "relax_width_deg": [8.0, 100.0],
                "heading_offset_deg": 0.0, "offset_ema": 0.15, "offset_max_deg": 20.0},
    // Zonas de interfaz que la deteccion ignora. Coordenadas del area de cliente.
    //  anchor: top-left, top-center, top-right, center-left, center, center-right,
    //          bottom-left, bottom-center, bottom-right (punto de la imagen donde se ancla).
    //  dx, dy: desplazamiento de la ESQUINA SUPERIOR IZQUIERDA del rectangulo respecto del ancla.
    //  w, h:   tamano en pixeles. Se recorta al tamano de la imagen (w grande = hasta el borde).
    // Asi la misma config vale aunque la captura mida unos pixeles distinto.
    "exclusion_zones": [
      { "name": "chat",       "anchor": "bottom-center", "dx": -340, "dy": -190, "w": 640,  "h": 190 },
      { "name": "exp_log",    "anchor": "bottom-center", "dx": 265,  "dy": -200, "w": 170,  "h": 200 },
      { "name": "bottom_bar", "anchor": "bottom-left",   "dx": 0,    "dy": -60,  "w": 4000, "h": 60 },
      { "name": "buffs",      "anchor": "top-left",      "dx": 0,    "dy": 0,    "w": 235,  "h": 130 },
      { "name": "quests",     "anchor": "center-left",   "dx": 0,    "dy": -260, "w": 112,  "h": 170 },
      { "name": "top_right",  "anchor": "top-right",     "dx": -420, "dy": 0,    "w": 420,  "h": 240 },
      { "name": "top_center", "anchor": "top-center",    "dx": -400, "dy": 0,    "w": 800,  "h": 80 }
    ],

    "metin": {
      // Carpeta con las plantillas de etiqueta (una por nombre de metin conocido).
      "label_templates_dir": "templates/labels",
      // Rango HSV (OpenCV: H 0-179) del naranja de los nombres de metin. El texto es BGR (0,128,255)
      // exacto; el rojo de monstruos, el verde de "Lv" y el amarillo quedan fuera.
      "hsv_lo": [13, 220, 220],
      "hsv_hi": [17, 255, 255],
      // Kernel [ancho, alto] de dilatacion que une las letras en una etiqueta.
      "group_kernel": [9, 3],
      // Tamano valido del texto de una etiqueta (px) y minimo de pixeles naranjas.
      "min_text_w": 40, "max_text_w": 160,
      "min_text_h": 6, "max_text_h": 16,
      "min_pixels": 60,
      // Se descarta la etiqueta si mas de esta fraccion de su rectangulo cae en zonas excluidas.
      "max_zone_overlap": 0.5,
      // Coincidencia minima con la plantilla y ventaja minima sobre la segunda mejor.
      // Ante la duda NO es objetivo.
      "min_score": 0.85,
      "min_margin": 0.1,
      // Punto de clic respecto del centro de la etiqueta: la piedra queda 55-80 px debajo.
      "click_dx": 0, "click_dy": 65
    },

    // Piedras de metin SIN etiqueta (bot/vision/far_metin.py): nucleo rojo "calido" con humo encima.
    // Medido sobre ./samples: piedras H 5-9, S 140-175, V>=150; el naranja de la piel de monstruos es H>=12,
    // el texto rojo/naranja tiene S>=245 y la sangre V<100. El humo es gris palido de matiz 14-45 (fondo azul, H~115).
    "far_metin": {
      "core_h_max": 9,                           // matiz del nucleo: 0..core_h_max (OpenCV 0-179)
      "core_s": [100, 205], "core_v_min": 150,   // saturacion min/max y brillo minimo del nucleo
      "smoke_hsv_lo": [14, 8, 105], "smoke_hsv_hi": [45, 80, 230],  // rango HSV del humo
      "group_kernel": [9, 9],                    // dilatacion [ancho, alto] que une los trozos de una piedra
      "min_core_pixels": 60, "min_smoke_pixels": 40,  // minimo de pixeles de nucleo y de humo encima
      "min_w": 8, "max_w": 140, "min_h": 8, "max_h": 160,  // tamano valido del cuerpo (px)
      // Zona de humo: desde smoke_height_frac*alto sobre la piedra hasta smoke_overlap_frac*alto dentro de ella,
      // con margen lateral smoke_side_frac*ancho + smoke_side_px (el humo se inclina).
      "smoke_height_frac": 1.2, "smoke_side_frac": 0.5, "smoke_side_px": 8, "smoke_overlap_frac": 0.15,
      "center_y_frac": 0.85,                     // el punto "center" (base) esta a esta fraccion del alto del cuerpo
      "max_zone_overlap": 0.5,                   // fraccion maxima del cuerpo dentro de zonas excluidas/ventanas
      "exclude_overlap": 0.3,                    // se descarta si mas de esta fraccion cae en un rect de `exclude`
      "core_ref": 300, "smoke_ref": 150,         // nucleo y humo que dan score 1 (score = promedio de ambos)
      // Segundo criterio, para piedras SIN humo (Metin Negro, anaranjado): cuerpo claro naranja sobre el nucleo.
      "alt_enabled": true,
      "alt_bright_lo": [3, 30, 200], "alt_bright_hi": [24, 190, 255],  // HSV de los pixeles claros del cuerpo
      "alt_min_bright_px": 100, "alt_min_bright_frac": 0.08,  // minimo de pixeles claros y fraccion de la ventana
      "alt_bright_max_ratio": 1.6,               // maximo de claros / nucleo (un efecto de habilidad es mucho mayor)
      "alt_min_ground_frac": 0.3,                // fraccion minima de suelo oscuro azulado alrededor
      // Filtros contra cuerpos de monstruos (en la prueba real, soldados/arqueras con ropa roja se tomaban por piedras):
      // monster_label_above_px / monster_label_dx_px: con una etiqueta de monstruo a <= above_px por encima de la base del
      //  candidato y con el centro a <= dx_px en horizontal, es el cuerpo de ese monstruo y se descarta.
      // min_size_ratio: sqrt(ancho*alto) del cuerpo / distancia de la base al horizonte (perspectiva). Medido: piedras reales
      //  0.11-0.31 (la mas chica 0.113); cuerpos de monstruos abajo de la pantalla 0.045-0.05. Menos que esto se descarta.
      // max_aspect: alto/ancho maximo (piedras reales <= 1.31; un personaje de pie mide ~2.2).
      "monster_label_above_px": 150, "monster_label_dx_px": 60, "min_size_ratio": 0.08, "max_aspect": 1.9,

      // --- Detector por ESTRUCTURA (bot/vision/far_structure.py): piedra + aura + humo, sin depender del color. ---
      // En otros mapas el metin puede ser verde/azul/violeta, pero siempre es una piedra con brillo saturado y humo palido arriba.
      // "mode": "color" = solo el nucleo rojo de arriba; "estructura" = solo el nuevo; "ambos" = union sin duplicados (default:
      //  el nuevo no esta probado en el juego; en las capturas reales encuentra todo lo que encuentra el de color y mas).
      "mode": "ambos",
      // Pista OPCIONAL de tono por tipo de metin ({slug: [h_min, h_max]}, OpenCV 0-179, puede envolver: [172, 18]). Si el tono del
      // blob cae en algun rango suma "hue_bonus" al puntaje. Nunca es requisito. La escribe `calibrate.py metin` / `calibrate.py tono`.
      "hue_hints": {},
      "structure": {
        // Fondo local = mediana de S y V sobre la imagen reducida (bg_scale) con ventana bg_kernel (px reducidos).
        "bg_scale": 4, "bg_kernel": 21,
        // Nucleo+aura: pixeles con saturacion >= core_ds sobre el fondo, brillo >= core_dv sobre el fondo y S >= core_s_min
        // (cualquier matiz). Medido: fondo S~45 V~72; piedra+aura S 100-190, V 100-255. Bajar si el metin nuevo es menos vivo
        // (cuesta falsos positivos: con ds=45, dv=25, s_min=75 aparecen ~7 en las capturas reales).
        "core_ds": 55, "core_dv": 35, "core_s_min": 90,
        "group_kernel": [9, 9],                  // dilatacion [ancho, alto] que une los trozos del blob
        "min_core_pixels": 120, "min_w": 12, "max_w": 140, "min_h": 12, "max_h": 160,  // tamano valido del blob (px)
        // Forma: alto/ancho >= min_aspect (el maximo es far_metin.max_aspect); relleno = pixeles / (ancho*alto) >= min_fill;
        // aislamiento (calm) = fraccion del anillo de ring_margin px que se parece al fondo (|dS|,|dV| < calm_d) >= min_calm.
        "min_aspect": 0.45, "min_fill": 0.38, "min_calm": 0.3,
        "max_zone_overlap": 0.7,                 // el blob incluye el aura: es mas grande que el nucleo rojo
        "ring_margin": 6, "calm_d": 25,
        // Humo: pixeles con S <= smoke_s_max y brillo >= smoke_dv sobre el fondo, en la zona de arriba (misma geometria que el
        // detector de color), al menos min_smoke_pixels repartidos en >= min_smoke_rows filas (con >= smoke_row_px cada una).
        "smoke_s_max": 75, "smoke_dv": 20, "smoke_row_px": 3, "min_smoke_pixels": 40, "min_smoke_rows": 5,
        "smoke_height_frac": 1.2, "smoke_side_frac": 0.5, "smoke_side_px": 8, "smoke_overlap_frac": 0.15,
        // Sin humo (Metin Negro): se acepta solo si es grande, compacto y MUY aislado; sale con smoke=false (mas dudoso).
        "nosmoke_enabled": true, "nosmoke_min_core": 500, "nosmoke_min_calm": 0.8, "nosmoke_min_fill": 0.5,
        "nosmoke_aspect": [0.6, 1.5],
        // Puntaje 0..1 = promedio ponderado de tamano del blob, humo, aura (fraccion con S >= glow_ds sobre el fondo) y
        // aislamiento. Medido: piedras reales >= 0.53; un cuerpo de monstruo dudoso 0.45. Se exige >= min_score.
        "glow_ds": 110, "glow_ref": 0.3, "core_ref": 700, "smoke_ref": 300,
        "weights": {"core": 0.3, "smoke": 0.3, "aura": 0.2, "calm": 0.2},
        "hue_bonus": 0.1, "hue_margin": 8, "min_score": 0.5
      }
    },

    // Etiquetas de monstruos (bot/vision/monsters.py): "Lv XX" verde plano pegado a la izquierda de un nombre
    // rojo plano. Colores exactos medidos en samples (el amarillo del personaje y el naranja de metin no calzan).
    "monsters": {
      "red_bgr": [9, 22, 235], "green_bgr": [51, 255, 152], "color_tol": 6,
      "green_kernel": [9, 1],                         // dilatacion [ancho, alto] que une "Lv" con el numero
      "min_red_pixels": 15, "min_green_pixels": 10,   // rojo minimo a la derecha del verde; verde minimo del bloque
      "min_green_w": 12, "max_green_w": 40, "min_green_h": 6, "max_green_h": 16,  // tamano del bloque "Lv XX"
      "probe_w": 30,                                  // ancho (px) donde se busca el rojo a la derecha del verde
      "max_gap_px": 10, "word_gap_px": 8,             // separacion maxima verde->rojo; hueco maximo entre palabras
      "max_label_w": 260,                             // ancho maximo de la etiqueta (verde + nombre)
      "max_zone_overlap": 0.5,
      "near_radius_px": 120,                          // "cerca del personaje" (px, centro de etiqueta a player_point)
      "on_me_px": 30,                                 // etiqueta de monstruo solapada o a <= on_me_px de la del personaje = bicho encima
      "on_me_body_px": 90                             // o con la etiqueta a <= on_me_body_px del personaje (montado: la propia queda ~50 px mas arriba)
    },

    // Etiqueta del propio personaje: "Lv NN" verde + nombre en AMARILLO plano (distinto de los monstruos: nivel verde y nombre
    // rojo). Con bichos pegados o encima de ella (monsters_on_me) casi seguro lo estan bloqueando.
    // search = [dx0, dy0, dx1, dy1] respecto del punto del personaje (montado la etiqueta queda ~130 px arriba).
    "own_label": { "name_bgr": [76, 215, 255], "search": [-170, -230, 170, -20] },

    // Menu de opciones del juego (lo abre Escape sin nada seleccionado). Se reconoce por el boton "Cancelar" (plantilla recortada
    // de una captura real: score 1.0 en 5 capturas con menu, < 0.45 en 73 sin menu). search = fracciones [x0, y0, x1, y1].
    // Se cierra con un clic en Cancelar cada close_retry_s; tras close_clicks clics sin cerrarlo, controls.close_menu.
    "game_menu": { "enabled": true, "template": "templates/ui/menu_cancelar.png", "min_score": 0.8,
                   "search": [0.3, 0.45, 0.7, 0.85], "close_retry_s": 1.0, "close_clicks": 3 },

    // Punto de clic sobre la parte VISIBLE de la piedra (bot/vision/click_point.py). Candidatos = grid (fracciones [fx, fy] del
    // rect del cuerpo, medido con el nucleo de color de far_metin), descartados si caen en la columna bajo una etiqueta de
    // monstruo (la silueta mide body_h_k * distancia al horizonte [min body_h_min_px], se extiende body_h_mult veces ese alto
    // hacia abajo, ancho body_w_frac de el + col_margin_px) o sobre la etiqueta del personaje (own_margin_px), o si el parche
    // de radio patch_r tiene < min_stone_frac de pixeles de color de piedra (calido, saturacion >= stone_s_min: un tronco o la
    // nieve son grises). stone_search = [medio ancho, arriba, abajo] px donde se busca el cuerpo cerca del punto de clic.
    "click_point": { "grid": [[0.5, 0.5], [0.5, 0.3], [0.5, 0.7], [0.3, 0.5], [0.7, 0.5], [0.3, 0.3], [0.7, 0.3],
                              [0.3, 0.7], [0.7, 0.7]],
                     "body_h_k": 0.33, "body_h_min_px": 40, "body_h_mult": 1.3, "body_w_frac": 0.3, "col_margin_px": 8,
                     "patch_r": 4, "min_stone_frac": 0.25, "stone_s_min": 60, "stone_search": [60, 60, 25],
                     "own_margin_px": 6 },

    // Objetos en el piso (bot/vision/items.py). El recuadro tiene borde negro exacto de 1 px, fondo oscuro
    // translucido y texto blanco sin antialiasing; una linea (alto 15 px) o dos (30 px) si tiene dueno, con el
    // nombre del dueno en amarillo (0,255,255) encima. "Yang" se reconoce por plantilla y NO se recoge.
    "items": {
      "yang_template": "templates/items/yang.png",  // mascara binaria (0/255) de la palabra "Yang"
      "border_color": [0, 0, 0],      // BGR del borde (exacto)
      "min_edge_run": 21,             // largo minimo (IMPAR) de un borde horizontal negro
      "box_w": [24, 260],             // ancho min/max del recuadro, borde incluido
      "box_dy": [14, 30],             // distancia minima y maxima entre borde superior e inferior
      "box_dy_allowed": [14, 30],     // distancias validas: 1 linea (alto 15), 2 lineas (alto 31)
      "box_dy_tol": 1,                // tolerancia (px) sobre box_dy_allowed
      "edge_x_tol": 6,                // diferencia maxima (px) de x/ancho entre el borde de arriba y el de abajo
      "border_min_frac": 0.7,         // fraccion minima negra de los dos bordes laterales (promedio; un objeto puede taparlos)
      "white_min": 250,               // canal minimo (B,G,R) del texto blanco
      "yellow_lo": [0, 230, 230],     // rango BGR del amarillo del dueno
      "yellow_hi": [30, 255, 255],
      "text_rows": 13,                // filas de la linea de texto, desde el borde inferior hacia arriba
      "min_white_px": 15,             // pixeles blancos minimos para considerar que hay un nombre
      "yellow_noise_px": 3,           // amarillo en la franja superior por encima de esto = tiene dueno (si no calza con el propio: reserved_other). Publicos reales: 0 px
      "owner_size_tol": 2,            // tolerancia (px) de tamano de la caja amarilla respecto de la plantilla del dueno
      "max_edges": 1500,              // tope de bordes candidatos por captura (samples: <=24); si se supera, WARNING y sin objetos ese ciclo
      "owner_template": "templates/items/owner.png",  // mascara del amarillo "Farfarfa's" (dueno propio)
      "owner_min_score": 0.95,        // score minimo para reserved; amarillo bajo eso = reserved_other (de otro)
      "yang_min_score": 0.85,         // score minimo de la plantilla "Yang" (kind="yang")
      "max_zone_overlap": 0.5         // fraccion maxima del recuadro en zonas excluidas
    },

    // Ventanas de interfaz que se pueden mover (inventario, Mapa grande). Se buscan en cada captura por la
    // plantilla de su barra de titulo (recortada desde la esquina superior izquierda del marco; generala con
    // tools/make_ui_template.py) y se excluyen enteras de la deteccion y de los clics.
    //  size: [ancho, alto] fijo de la ventana completa en pixeles (la esquina sup. izq. es donde calza la plantilla).
    //  min_score: coincidencia minima (0-1) de la plantilla; las capturas sin esas ventanas dan ~0.3 o menos.
    // Busqueda en dos pasos: gruesa en gris a coarse_scale (umbral coarse_min_score) y refinada a
    // resolucion completa en +-refine_margin px (umbral min_score).
    // anchor2: segundo ancla (esquina/borde inferior del marco) por si el titulo esta tapado o fuera de
    // la imagen; offset = [dx, dy] del recorte respecto de la esquina sup. izq. de la ventana.
    "ui_windows": {
      "min_score": 0.8,
      "coarse_scale": 0.25,
      "coarse_min_score": 0.5,
      "refine_margin": 4,
      // safety_margin: px que se agregan por cada lado a las ventanas detectadas en la mascara, para que
      // ningun clic quede pegado a su borde (la piedra mide ~40 px y el clic puede errar ~10 px).
      // alt: variantes de la misma ventana con otro tamano (inventario compacto, sin panel de estadisticas);
      // solo se prueban si no calza la principal.
      "safety_margin": 30,
      "windows": [
        { "name": "mapa_grande", "template": "templates/ui/mapa_grande.png", "size": [214, 289],
          "anchor2": { "template": "templates/ui/mapa_grande_base.png", "offset": [0, 268] } },
        { "name": "inventario",  "template": "templates/ui/inventario.png",  "size": [295, 575],
          "anchor2": { "template": "templates/ui/inventario_base.png", "offset": [0, 539] },
          "alt": [ { "template": "templates/ui/inventario_compacto.png", "size": [165, 575] } ] }
      ]
    },

    // Panel "Bot Verify": SOLO se detecta (el bot no lo resuelve; pausa y suena la alarma). Dos anclas fijas
    // que no dependen de los digitos: el pie (boton OK + "Bot Verify") y el bloque de botones 1-9. offset = esquina sup.
    // izq. del recorte respecto de la esquina sup. izq. del panel. size = [ancho, alto] del panel.
    // Busqueda gruesa en gris a coarse_scale (umbral coarse_min_score) y refinada a resolucion completa.
    "captcha": {
      "min_score": 0.8, "coarse_scale": 0.25, "coarse_min_score": 0.5, "refine_margin": 4,
      "size": [152, 194],
      // Zona fija donde aparece el panel (formato de las zonas excluidas: anchor + dx/dy + w/h), con ~80 px de
      // holgura por lado. El loop busca solo aca en cada ciclo (pocos ms) y en toda la imagen cada N ciclos
      // como respaldo (find_captcha(..., full=True)).
      "search_region": { "anchor": "center-right", "dx": -400, "dy": -180, "w": 400, "h": 374 },
      "footer": { "template": "templates/captcha/pie.png",    "offset": [24, 146] },
      "keypad": { "template": "templates/captcha/teclado.png", "offset": [9, 49] },
      // Captcha de la FRASE (cartel dorado arriba al centro: "la siguiente frase es: - - - p - - ..."). El bot NO lo resuelve:
      // se trata como el captcha normal. El marco es el mismo de los anuncios del servidor, asi que ademas de la barra con las
      // manijas (frame) se exige el texto fijo "la siguiente frase es:" (text) en cualquier lugar del cuerpo del cartel;
      // las letras a completar no importan. size = [ancho, alto] del cartel desde la barra; search_region = donde buscar la barra.
      "frase": {
        "search_region": { "anchor": "top-center", "dx": -500, "dy": 100, "w": 1000, "h": 140 },
        "frame": { "template": "templates/captcha/frase_marco.png", "min_score": 0.8 },
        "text":  { "template": "templates/captcha/frase_texto.png", "min_score": 0.8 },
        "size": [548, 66]
      }
    },

    // Pantalla de muerte: botones "Volver a Empezar Aqui" y "...en la Ciudad". search = region (desde la
    // esquina sup. izq. de la imagen) donde se buscan las plantillas. Calza cualquiera de los dos.
    "death": {
      "search": { "w": 420, "h": 320 },
      "min_score": 0.8, "coarse_scale": 0.5, "coarse_min_score": 0.5, "refine_margin": 4,
      "here_template": "templates/death/aqui.png",
      "city_template": "templates/death/ciudad.png"
    },

    // Posicion del personaje respecto del centro de la imagen (va montado, un poco mas abajo).
    "player_offset": [0, 20],

    // Lectura de numeros por plantillas de caracter (bot/vision/digits.py), un set por fuente.
    // dir: carpeta con un PNG por caracter (0.png..9.png, dot, slash, lparen, rparen, comma);
    //      se completan con tools/make_glyph_templates.py.
    // color / color_tol: color BGR exacto del texto (sin antialiasing) y tolerancia por canal.
    // min_score: similitud minima (Jaccard) para aceptar un caracter; si no, sale como '?'.
    // min_margin: ventaja minima del mejor glifo sobre el segundo (8/9 y 8/6 se parecen 0.80; un digito
    //   tapado a medias no puede pasar por otro). Digitos completos: 1.0 contra <= 0.80.
    // max_gap / max_gap_after_comma: hueco maximo (px) entre caracteres; uno mayor es un caracter
    //   tapado ('?'). Despues de la coma va un espacio.
    "glyphs": {
      "coords": {"dir": "templates/glyphs/coords", "color": [217, 217, 217], "color_tol": 12, "min_score": 0.9,
                 "min_margin": 0.15, "max_gap": 3, "max_gap_after_comma": 7},
      "panel":  {"dir": "templates/glyphs/panel",  "color": [199, 199, 199], "color_tol": 12, "min_score": 0.9,
                 "min_margin": 0.15, "max_gap": 3, "max_gap_after_comma": 7}
    },

    // Coordenadas "(x, y)" debajo del minimapa. search: region de busqueda (ancla + dx/dy/w/h; la linea se
    // corre en vertical entre capturas, asi que se busca por su aspecto). line_w / line_h: [min, max] del
    // ancho y alto de la linea de texto. range: valores validos de x e y. min_score: confianza minima.
    "coords": {
      "search": {"anchor": "top-right", "dx": -200, "dy": 140, "w": 200, "h": 110},
      "line_w": [20, 90], "line_h": [9, 12],
      "range": [0, 4000],
      "min_score": 0.9
    },

    // Panel superior (nombre, barra y numero de vida). Todo se ubica relativo al marco, que se busca por
    // el color exacto de su borde en `search`.
    "panel": {
      "search": {"anchor": "top-center", "dx": -450, "dy": 0, "w": 900, "h": 110},
      "frame_color": [85, 85, 85],   // borde del marco
      "frame_min_w": 150,            // largo minimo del borde horizontal (sin contar adornos de las esquinas)
      "frame_h": [30, 90],           // alto minimo y maximo del marco
      "frame_x_tol": 2,              // diferencia maxima (px) de x entre el borde superior y el inferior
      "frame_edge_merge": 1,         // filas consecutivas del mismo borde que cuentan como una sola
      "name_templates_dir": "templates/panel_names",  // plantillas del nombre entero (tools/make_panel_name_template.py)
      "name_color": [199, 199, 199], "name_color_tol": 12,
      // Linea del nombre: x desde el borde izquierdo hasta (borde derecho + x_to_right); y desde el borde superior.
      "name_region": {"x_from_left": 8, "x_to_right": -176, "dy": 14, "h": 16},
      "name_min_score": 0.85,        // score minimo del nombre
      "name_min_margin": 0.1,        // ventaja minima sobre el segundo mejor nombre
      // Barra: las tapas doradas (R >= G+cap_diff y G >= B+cap_diff) dentro de la banda de filas `band` y de
      // columnas `search_x` (relativas al borde derecho) delimitan el recipiente, de ancho `width` +- width_tol.
      // gold_gap: columnas vacias que separan dos tapas doradas. Sin barra validada no se acepta el numero.
      // Rojo lleno: R >= red_min_r, G y B <= red_max_gb, R-G >= red_min_rg.
      "bar": {"band": [17, 24], "search_x": [-200, -24], "cap_diff": 25, "gold_gap": 4, "width": 108, "width_tol": 3,
              "red_min_r": 110, "red_max_gb": 110, "red_min_rg": 40},
      // Numero "actual/maxima": region desde el borde derecho (dx) y superior (dy).
      "number_region": {"dx": -165, "w": 115, "dy": 4, "h": 13},
      "hp_ratio_tol": 0.03           // diferencia maxima entre actual/maxima y la barra para validar el numero
    }
  }
}
